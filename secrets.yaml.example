# SPDX-License-Identifier: GPL-3.0-only
# Als secrets.yaml kopieren und jeden Platzhalter ersetzen.
wifi_ssid: "DEIN_2_4_GHZ_WLAN"
wifi_password: "DEIN_WLAN_PASSWORT"

# Neuer API-Schlüssel: openssl rand -base64 32
# Bei bestehender HA-Einbindung den aktuell verwendeten Schlüssel übernehmen.
utrusta_api_key: "HIER_BASE64_SCHLUESSEL_EINTRAGEN"

# Jeweils getrennt erzeugen: openssl rand -hex 16
# Bei bestehendem OTA-Zugang dessen Passwort übernehmen.
utrusta_ota_password: "HIER_OTA_PASSWORT_EINTRAGEN"
utrusta_fallback_password: "HIER_FALLBACK_AP_PASSWORT_EINTRAGEN"

# Beispiel ersetzen. Vier Hex-Ziffern erzeugen: openssl rand -hex 2
utrusta_sender_address: "0x1234"
